<Window x:Class="PrimeWatcher.BatteryWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Prime Watcher · Виджет" Width="232" SizeToContent="Height" MaxHeight="340"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" Foreground="#F2EFFA"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
    <Border Background="#F31E1F29" BorderThickness="1" CornerRadius="13" Padding="9,7">
        <Border.BorderBrush>
            <SolidColorBrush x:Name="FrameColor" Color="#716383" />
        </Border.BorderBrush>
        <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Top" Background="Transparent" Padding="1,1,0,6" Cursor="SizeAll"
                    MouseLeftButtonDown="BeginDrag" MouseMove="ContinueDrag" MouseLeftButtonUp="EndDrag"
                    LostMouseCapture="DragCaptureLost">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="PrimeWatcher.ico" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="Prime Watcher" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="⠿" Foreground="#B4B1C6" HorizontalAlignment="Right" VerticalAlignment="Center"
                               ToolTip="Перетащите, чтобы переместить виджет" />
                </Grid>
            </Border>
            <TextBlock x:Name="LowChargeNotice" DockPanel.Dock="Top" Text="Низкий заряд" FontWeight="SemiBold"
                       Foreground="#FFC1BA" Margin="1,0,0,5" Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="Empty" DockPanel.Dock="Top" FontSize="11" Foreground="#B4B1C6"
                       Text="Нет устройств для отображения" TextWrapping="Wrap" Margin="1,4,0,2" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Devices">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,1" Padding="6,4" CornerRadius="6" ToolTip="{Binding Description}"
                                    AutomationProperties.Name="{Binding Description}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#322E42" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Low}" Value="True">
                                                <Setter Property="Background" Value="#52343D" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{Binding Glyph}" Stroke="#C4B4FF" StrokeThickness="1.3"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Charge}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#D9CCFF" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Low}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFC1BA" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Muted}" Value="True">
                                                        <Setter Property="Foreground" Value="#B4B1C6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
