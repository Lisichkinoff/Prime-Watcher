<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <StartupObject>PrimeWatcher.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PrimeWatcher</AssemblyName>
    <ApplicationIcon>PrimeWatcher.ico</ApplicationIcon>
    <Version>1.0.4</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="PrimeWatcher.ico" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
