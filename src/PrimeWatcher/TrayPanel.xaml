<Window x:Class="PrimeWatcher.TrayPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Prime Watcher" Width="386" SizeToContent="Height" MaxHeight="610"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#F4F7FB" />
        <SolidColorBrush x:Key="Muted" Color="#AAB8CC" />
        <SolidColorBrush x:Key="Accent" Color="#82E9D4" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="#253247" />
            <Setter Property="BorderBrush" Value="#3A4960" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#354860" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Padding="17" Background="#131D2D" BorderBrush="#43536C" BorderThickness="1" CornerRadius="13">
        <DockPanel LastChildFill="True">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Prime Watcher" FontWeight="SemiBold" FontSize="21" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="⚙" Margin="0,0,6,0" Width="34" Height="32" Padding="0"
                        FontSize="16" ToolTip="Настройки" AutomationProperties.Name="Настройки" Click="ToggleSettings" />
                <Button Grid.Column="2" Content="×" Width="34" Height="32" Padding="0" FontSize="20"
                        ToolTip="Закрыть панель" AutomationProperties.Name="Закрыть панель" Click="ClosePanel" />
            </Grid>
            <Border x:Name="Guide" DockPanel.Dock="Top" Background="#20364A" CornerRadius="7" Padding="11"
                    Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Как оставить значок рядом с часами" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,8" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                               Text="Откройте меню скрытых значков стрелкой рядом с часами и перетащите Prime Watcher на панель задач." />
                    <Button Content="Понятно" HorizontalAlignment="Left" Click="DismissGuide" />
                </StackPanel>
            </Border>
            <Border x:Name="Settings" DockPanel.Dock="Top" Background="#1C293D" CornerRadius="7" Padding="11"
                    Margin="0,0,0,10" Visibility="Collapsed">
                <CheckBox x:Name="AutoStart" Content="Запускать при входе в Windows" Foreground="{StaticResource Text}"
                          Click="AutoStartChanged" />
            </Border>
            <Border x:Name="UpdateBanner" DockPanel.Dock="Bottom" Background="#20364A" CornerRadius="7"
                    Padding="11" Margin="0,10,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="UpdateMessage" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="Restart" Content="Перезапустить сейчас" Margin="0,8,0,0" HorizontalAlignment="Left"
                            Click="RestartClicked" Visibility="Collapsed" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="Empty" DockPanel.Dock="Top" Text="Поиск подключённых устройств…"
                       Foreground="{StaticResource Muted}" Margin="0,8,0,10" TextWrapping="Wrap" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Devices">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1C293D" Padding="10" CornerRadius="7" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Charge}" Margin="0,3,0,0" Foreground="{StaticResource Accent}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" Foreground="{StaticResource Muted}"
                                                   FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Margin="7,0,0,0" Padding="7,5"
                                            Content="{Binding PinLabel}" Tag="{Binding Id}"
                                            AutomationProperties.Name="{Binding PinDescription}" Click="PinDevice"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
