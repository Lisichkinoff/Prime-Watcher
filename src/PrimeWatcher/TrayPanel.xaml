<Window x:Class="PrimeWatcher.TrayPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Prime Watcher" Width="432" SizeToContent="Height" MaxHeight="600"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" Foreground="#F2EFFA"
        FontFamily="Segoe UI" FontSize="14" Icon="PrimeWatcher.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#B4B1C6" />
        <SolidColorBrush x:Key="Accent" Color="#C4B4FF" />
        <SolidColorBrush x:Key="PanelFill" Color="#292B38" />
        <SolidColorBrush x:Key="PanelLine" Color="#3A3C4D" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{StaticResource PanelFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelLine}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F2EFFA" />
            <Setter Property="Background" Value="#323442" />
            <Setter Property="BorderBrush" Value="#53556A" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#49435D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#393348" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="36" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Selected">
                    <Setter Property="Background" Value="#423757" />
                    <Setter Property="BorderBrush" Value="#615178" />
                    <Setter Property="Foreground" Value="#EEE6FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F2EFFA" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent">
                            <Border x:Name="Box" DockPanel.Dock="Left" Width="17" Height="17" Margin="0,0,9,0"
                                    CornerRadius="4" BorderThickness="1" BorderBrush="#827E94"
                                    Background="#252632" VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M 1,5 L 4,8 L 10,2" Stroke="#261B37" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                                      Width="10" Height="8" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageUpCommand}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#615C76" Margin="2,0" CornerRadius="3" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageDownCommand}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Padding="16" Background="#1E1F29" BorderBrush="#454658" BorderThickness="1" CornerRadius="20">
        <DockPanel LastChildFill="True">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Source="PrimeWatcher.ico" Width="32" Height="32" Margin="0,0,9,0" />
                    <TextBlock Text="Prime Watcher" FontWeight="SemiBold" FontSize="20" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Content="×" Width="32" Height="32" Padding="0" FontSize="20"
                        Background="Transparent" ToolTip="Закрыть панель"
                        AutomationProperties.Name="Закрыть панель" Click="ClosePanel" />
            </Grid>
            <Border DockPanel.Dock="Top" Background="#252632" CornerRadius="13" Padding="3" Margin="0,0,0,12">
                <UniformGrid Columns="3">
                    <Button x:Name="DevicesTab" Style="{StaticResource TabButton}" Content="Устройства"
                            Tag="Selected" Click="ShowDevices" />
                    <Button x:Name="SettingsTab" Style="{StaticResource TabButton}" Content="Настройки"
                            Click="ShowSettings" />
                    <Button x:Name="WidgetTab" Style="{StaticResource TabButton}" Content="Виджет"
                            Click="ShowWidgetSettings" />
                </UniformGrid>
            </Border>
            <Border x:Name="Guide" DockPanel.Dock="Top" Style="{StaticResource Card}"
                    Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Как оставить значок рядом с часами" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,8" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                               Text="Откройте меню скрытых значков стрелкой рядом с часами и перетащите Prime Watcher на панель задач." />
                    <Button Content="Понятно" HorizontalAlignment="Left" Click="DismissGuide" />
                </StackPanel>
            </Border>
            <Border x:Name="Notice" DockPanel.Dock="Bottom" Style="{StaticResource Card}" Background="#302942"
                    Padding="11" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock x:Name="NoticeMessage" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </Border>
            <Grid>
                <ScrollViewer x:Name="DeviceView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="Empty" Text="Поиск подключённых устройств…" Margin="0,4,0,8"
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        <ItemsControl x:Name="Devices">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="10" Background="#3B3351"
                                                    Margin="0,0,10,0" VerticalAlignment="Top">
                                                <Path Data="{Binding Glyph}" Width="18" Height="18" Stretch="Uniform"
                                                      Stroke="{StaticResource Accent}" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                                           Margin="0,2,0,0" Foreground="{StaticResource Muted}" />
                                                <TextBlock Text="{Binding Charge}" Margin="0,5,0,0" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Margin="9,0,0,0" FontSize="12"
                                                    Content="{Binding PinLabel}" Tag="{Binding Id}"
                                                    ToolTip="{Binding PinDescription}"
                                                    AutomationProperties.Name="{Binding PinDescription}"
                                                    Click="PinDevice" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Приложение" Style="{StaticResource SectionHeading}" />
                                <CheckBox x:Name="AutoStart" Content="Запускать при входе в Windows" Click="AutoStartChanged" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Панель задач Windows" Style="{StaticResource SectionHeading}" />
                                <CheckBox x:Name="ShowTaskbarIndicators" Content="Показывать индикаторы рядом с часами"
                                          Click="TaskbarIndicatorsChanged" />
                                <StackPanel IsEnabled="{Binding IsChecked, ElementName=ShowTaskbarIndicators}">
                                    <CheckBox x:Name="TaskbarShowValues" Content="Показывать значения заряда рядом со значками"
                                              Click="TaskbarOptionsChanged" />
                                    <CheckBox x:Name="TaskbarOnlyWithCharge" Content="Скрывать устройства без показаний заряда"
                                              Click="TaskbarOptionsChanged" />
                                    <CheckBox x:Name="TaskbarOnePerKind" Content="Показывать по одному устройству каждого типа"
                                              Click="TaskbarOptionsChanged" />
                                    <TextBlock Text="Типы устройств" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                                               Margin="0,9,0,2" />
                                    <UniformGrid Columns="2">
                                        <CheckBox x:Name="HeadsetOption" Tag="Headset" Content="Наушники" Click="TaskbarKindChanged" />
                                        <CheckBox x:Name="MouseOption" Tag="Mouse" Content="Мыши" Click="TaskbarKindChanged" />
                                        <CheckBox x:Name="KeyboardOption" Tag="Keyboard" Content="Клавиатуры" Click="TaskbarKindChanged" />
                                        <CheckBox x:Name="GamepadOption" Tag="Gamepad" Content="Геймпады" Click="TaskbarKindChanged" />
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="DeviceOptionsCard" Style="{StaticResource Card}"
                                IsEnabled="{Binding IsChecked, ElementName=ShowTaskbarIndicators}" Visibility="Collapsed"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Устройства на панели задач" Style="{StaticResource SectionHeading}" />
                                <TextBlock Text="Выберите устройства среди включённых типов."
                                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,5" TextWrapping="Wrap" />
                                <ItemsControl x:Name="DeviceOptions">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Tag="{Binding Id}" IsChecked="{Binding Enabled, Mode=OneWay}"
                                                      Click="TaskbarDeviceChanged" AutomationProperties.Name="{Binding Name}">
                                                <StackPanel Margin="0,3">
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Transport}" FontSize="11"
                                                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border x:Name="UpdatesCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Обновления" Style="{StaticResource SectionHeading}" />
                                <TextBlock x:Name="InstalledVersion" Foreground="{StaticResource Muted}" FontSize="12" />
                                <TextBlock x:Name="UpdateStatus" Margin="0,5,0,0" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                                <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Height="5"
                                             Foreground="{StaticResource Accent}" Margin="0,8,0,0"
                                             AutomationProperties.Name="Загрузка обновления" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                    <Button x:Name="CheckForUpdates" Content="Проверить обновления"
                                            HorizontalAlignment="Left" Click="CheckForUpdatesClicked" />
                                    <Button x:Name="Restart" Content="Перезапустить сейчас" HorizontalAlignment="Left"
                                            Click="RestartClicked" Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="WidgetView" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Плавающий виджет" Style="{StaticResource SectionHeading}" />
                                <CheckBox x:Name="WidgetEnabled" Content="Показывать поверх всех окон" Click="WidgetOptionsChanged" />
                                <StackPanel IsEnabled="{Binding IsChecked, ElementName=WidgetEnabled}">
                                    <CheckBox x:Name="WidgetOnlyWhenLow" Content="Показывать только при низком заряде"
                                              Click="WidgetOptionsChanged" />
                                    <TextBlock x:Name="WidgetAlertHint" Foreground="{StaticResource Muted}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,0,0,7" />
                                    <CheckBox x:Name="WidgetClickThrough" Content="Пропускать клики мыши"
                                              Click="WidgetOptionsChanged" />
                                    <TextBlock Text="Чтобы переместить виджет, отключите пропуск кликов и перетащите его за заголовок."
                                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <CheckBox x:Name="WidgetUseTaskbarSelection" Content="Использовать выбор устройств панели задач"
                                              Click="WidgetOptionsChanged">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=WidgetOnlyWhenLow}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,4">
                                        <Run Text="Низкий заряд · " /><Run Text="{Binding Value, ElementName=WidgetLowCharge, Mode=OneWay, StringFormat={}{0:0}%}" />
                                    </TextBlock>
                                    <Slider x:Name="WidgetLowCharge" Minimum="5" Maximum="40" TickFrequency="5"
                                            IsSnapToTickEnabled="True" AutomationProperties.Name="Порог низкого заряда"
                                            ValueChanged="WidgetLowChargeChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="WidgetDevicesCard" Style="{StaticResource Card}" Visibility="Collapsed">
                            <StackPanel IsEnabled="{Binding IsChecked, ElementName=WidgetEnabled}">
                                <TextBlock Text="Устройства в виджете" Style="{StaticResource SectionHeading}" />
                                <ItemsControl x:Name="WidgetDeviceOptions">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Tag="{Binding Id}" IsChecked="{Binding WidgetEnabled, Mode=OneWay}"
                                                      Click="WidgetDeviceChanged" AutomationProperties.Name="{Binding Name}">
                                                <StackPanel Margin="0,3">
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Transport}" FontSize="11"
                                                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
